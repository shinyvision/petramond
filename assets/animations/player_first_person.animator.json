{
  "libraries": [],
  "params": {
    "speed": 0,
    "forward": 0,
    "strafe": 0,
    "vertical": 0,
    "grounded": 1,
    "sneaking": 0,
    "sprinting": 0,
    "swimming": 0,
    "climbing": 0,
    "pitch": 0,
    "yaw_rate": 0,
    "pitch_rate": 0,
    "stride": 0,
    "stride_weight": 0,
    "hurt": 0,
    "sleeping": 0,
    "impact": 0,
    "target": 0,
    "main.held": 0,
    "main.kind": "none",
    "main.tool": "none",
    "main.mining": 0,
    "main.eating": 0,
    "main.swing_claim": 0,
    "main.jab_claim": 0,
    "off.held": 0,
    "off.kind": "none",
    "off.eating": 0,
    "off.jab_claim": 0
  },
  "events": [
    "hurt",
    "jump",
    "land",
    "strike",
    "main.swing",
    "main.break",
    "main.place",
    "main.interact",
    "main.throw",
    "main.equip",
    "main.mine",
    "main.eat",
    "off.place",
    "off.interact",
    "off.equip",
    "off.eat"
  ],
  "slots": ["main", "off", "main_claim", "off_claim", "land", "hurt", "strike", "equip", "off_equip", "place", "off_place", "jab", "off_jab", "flourish"],
  "masks": {
    "main": {"right_mount": 1, "camera": 1},
    "off": {"left_mount": 1, "camera": 1},
    "claim": {"right_mount": 1, "left_mount": 1, "camera": 1},
    "right_arm": {"right_mount": 1},
    "left_arm": {"left_mount": 1}
  },
  "markers": {"impact": "strike"},
  "gates": [
    {"id": "swing_claim", "on": ["main.swing", "main.mine", "main.break"], "slot": "main", "when": "!main.swing_claim"},
    {"id": "jab_claim", "on": ["main.place", "main.interact", "main.throw"], "when": "!main.jab_claim"},
    {"id": "off_jab_claim", "on": ["off.place", "off.interact"], "when": "!off.jab_claim"}
  ],
  "layers": [
    {"name": "stance", "states": {"stand": "petramond:fp_idle", "swim": "petramond:fp_swim", "climb": {"clip": "petramond:fp_climb", "rate": "clamp(abs(vertical) / 2.2, 0, 1.6)"}}, "initial": "stand", "transitions": [{"from": ["stand", "climb"], "to": "swim", "when": "swimming", "fade": 0.3}, {"from": ["stand", "swim"], "to": "climb", "when": "climbing && !swimming", "fade": 0.25}, {"from": ["swim", "climb"], "to": "stand", "when": "!swimming && !climbing", "fade": 0.3}]},
    {"name": "off_arm", "mask": {"left_mount": 1}, "states": {"shown": null, "away": "petramond:fp_off_away"}, "initial": "away", "transitions": [{"from": "away", "to": "shown", "when": "off.held || swimming || climbing || slot.off > 0", "fade": 0.28, "ease": "out"}, {"from": "shown", "to": "away", "when": "!off.held && !swimming && !climbing && slot.off == 0", "fade": 0.25, "ease": "in"}]},
    {"name": "hold_block", "mask": "main", "weight": "smooth(main.kind == \"block\" && !swimming && !climbing, 0.1)", "clip": "petramond:fp_hold_block"},
    {"name": "hold_model", "mask": "main", "weight": "smooth(main.kind == \"model\" && !swimming && !climbing, 0.1)", "clip": "petramond:fp_hold_model"},
    {"name": "off_hold_block", "mask": "off", "weight": "smooth(off.kind == \"block\" && !swimming && !climbing, 0.1)", "mirror": {"clip": "petramond:fp_hold_block"}},
    {"name": "off_hold_model", "mask": "off", "weight": "smooth(off.kind == \"model\" && !swimming && !climbing, 0.1)", "mirror": {"clip": "petramond:fp_hold_model"}},
    {"name": "walk", "mode": "additive", "weight": "stride_weight * (1 - smooth(swimming || climbing, 0.1))", "clip": "petramond:fp_walk", "progress": "stride"},
    {"name": "sprint", "mode": "additive", "weight": "smooth(sprinting && speed > 3 && grounded && !swimming, 0.12)", "clip": "petramond:fp_sprint_pose"},
    {"name": "sneak", "mode": "additive", "weight": "smooth(sneaking && !swimming, 0.1)", "clip": "petramond:fp_sneak_pose"},
    {"name": "main_action", "mask": "main", "slot": "main"},
    {"name": "off_action", "mask": "off", "slot": "off"},
    {"name": "main_claim", "mask": "claim", "slot": "main_claim"},
    {"name": "off_claim", "mask": "claim", "slot": "off_claim"},
    {"name": "landing", "mode": "additive", "weight": "clamp(impact / 16, 0.3, 1.25)", "slot": "land"},
    {"name": "hurt", "mode": "additive", "slot": "hurt"},
    {"name": "equip", "mode": "additive", "slot": "equip"},
    {"name": "off_equip", "mode": "additive", "slot": "off_equip"},
    {"name": "place", "mode": "additive", "slot": "place"},
    {"name": "off_place", "mode": "additive", "slot": "off_place"},
    {"name": "jab", "mode": "additive", "mask": "right_arm", "slot": "jab"},
    {"name": "off_jab", "mode": "additive", "mask": "left_arm", "slot": "off_jab"},
    {"name": "flourish", "mode": "additive", "slot": "flourish"},
    {"name": "strike", "mode": "additive", "weight": "0.7 + 0.6 * (target > 1.5)", "slot": "strike"},
    {"name": "sway", "mode": "additive", "bones": {"right_mount": {"position": ["spring(clamp(-yaw_rate * 0.004 - strafe * 0.12, -1.6, 1.6), 0.08)", "spring(clamp(-pitch_rate * 0.003, -1.2, 1.2) + clamp(-vertical * 0.07, -0.7, 1.4) * (1 - grounded), 0.1)", "spring(clamp(-forward * 0.05, -0.6, 0.6), 0.15)"]}, "left_mount": {"position": ["spring(clamp(-yaw_rate * 0.004 - strafe * 0.12, -1.6, 1.6), 0.08)", "spring(clamp(-pitch_rate * 0.003, -1.2, 1.2) + clamp(-vertical * 0.07, -0.7, 1.4) * (1 - grounded), 0.1)", "spring(clamp(-forward * 0.05, -0.6, 0.6), 0.15)"]}, "camera": {"rotation": ["0", "0", "spring(clamp(-strafe * 0.3, -1.3, 1.3), 0.14)"]}}}
  ],
  "rules": [
    {"id": "main_equip", "on": "main.equip", "when": "!sleeping", "slot": "equip", "play": "petramond:fp_equip", "fade_in": 0, "fade_out": 0.06},
    {"id": "main_mine_tool", "on": "main.mine", "slot": "main", "priority": 2, "play": "petramond:fp_mine_start_{main.tool}", "then": [{"clip": "petramond:fp_mine_{main.tool}", "while": "main.mining", "exit": "finish"}], "blend": "inertial", "fade_in": 0.05, "fade_out": 0.12},
    {"id": "main_mine_hand", "on": "main.mine", "slot": "main", "priority": 2, "play": "petramond:fp_mine_start_hand", "then": [{"clip": "petramond:fp_mine_hand", "while": "main.mining", "exit": "finish"}], "blend": "inertial", "fade_in": 0.05, "fade_out": 0.12},
    {"id": "main_swing_sword", "on": "main.swing", "when": "!main.mining && main.tool == \"sword\"", "slot": "main", "priority": 2, "play": ["petramond:fp_slash_a", "petramond:fp_slash_b"], "reset": 0.9, "blend": "inertial", "fade_in": 0.06, "fade_out": 0.12},
    {"id": "main_swing_shears", "on": "main.swing", "when": "!main.mining && main.tool == \"shears\"", "slot": "main", "priority": 2, "play": "petramond:fp_swing_shears", "blend": "inertial", "fade_in": 0.06, "fade_out": 0.1},
    {"id": "main_swing_tool", "on": "main.swing", "when": "!main.mining", "slot": "main", "priority": 2, "play": "petramond:fp_swing_{main.tool}", "blend": "inertial", "fade_in": 0.06, "fade_out": 0.12},
    {"id": "main_swing_hand", "on": "main.swing", "when": "!main.mining", "slot": "main", "priority": 2, "play": ["petramond:fp_punch_a", "petramond:fp_punch_b"], "reset": 0.7, "blend": "inertial", "fade_in": 0.05, "fade_out": 0.1},
    {"id": "main_break_strike", "on": "main.break", "fallthrough": true, "slot": "strike", "play": "petramond:fp_strike", "fade_in": 0, "fade_out": 0.04},
    {"id": "main_break_shovel_flourish", "on": "main.break", "when": "main.tool == \"shovel\"", "fallthrough": true, "slot": "flourish", "play": "petramond:fp_shovel_toss", "fade_in": 0, "fade_out": 0.04},
    {"id": "main_break_tool", "on": "main.break", "when": "!main.mining && slot.main == 0", "slot": "main", "play": "petramond:fp_swing_{main.tool}", "blend": "inertial", "fade_in": 0.06, "fade_out": 0.12},
    {"id": "main_break_hand", "on": "main.break", "when": "!main.mining && slot.main == 0", "slot": "main", "play": ["petramond:fp_punch_a", "petramond:fp_punch_b"], "reset": 0.7, "blend": "inertial", "fade_in": 0.05, "fade_out": 0.1},
    {"id": "main_place", "on": "main.place", "slot": "place", "play": "petramond:fp_place", "fade_in": 0, "fade_out": 0.03},
    {"id": "main_interact", "on": "main.interact", "slot": "jab", "play": "petramond:fp_place", "fade_in": 0, "fade_out": 0.03},
    {"id": "main_throw", "on": "main.throw", "slot": "jab", "play": "petramond:fp_place", "fade_in": 0, "fade_out": 0.03},
    {"id": "main_eat", "on": "main.eat", "slot": "main", "priority": 1, "play": "petramond:fp_eat_raise", "then": [{"clip": "petramond:fp_eat_chew", "while": "main.eating"}], "blend": "inertial", "fade_in": 0.28, "fade_out": 0.22},
    {"id": "off_equip", "on": "off.equip", "slot": "off_equip", "play": "petramond:fp_equip", "mirror": 1, "fade_in": 0, "fade_out": 0.06},
    {"id": "off_place", "on": "off.place", "slot": "off_place", "play": "petramond:fp_place", "mirror": 1, "fade_in": 0, "fade_out": 0.03},
    {"id": "off_interact", "on": "off.interact", "slot": "off_jab", "play": "petramond:fp_place", "mirror": 1, "fade_in": 0, "fade_out": 0.03},
    {"id": "off_eat", "on": "off.eat", "slot": "off", "priority": 1, "mirror": 1, "play": "petramond:fp_eat_raise", "then": [{"clip": "petramond:fp_eat_chew", "while": "off.eating"}], "blend": "inertial", "fade_in": 0.28, "fade_out": 0.22},
    {"id": "strike_hitstop_creature", "on": "strike", "when": "target > 1.5", "fallthrough": true, "slot": "main", "hitstop": 0.07},
    {"id": "strike_hitstop_block", "on": "strike", "when": "target > 0.5 && target < 1.5 && !main.mining", "fallthrough": true, "slot": "main", "hitstop": 0.035},
    {"id": "strike", "on": "strike", "when": "target > 1.5 || (target > 0.5 && !main.mining)", "slot": "strike", "play": "petramond:fp_strike", "fade_in": 0, "fade_out": 0.04},
    {"id": "land", "on": "land", "when": "impact > 4", "slot": "land", "play": "petramond:fp_land", "fade_in": 0, "fade_out": 0.1},
    {"id": "jump", "on": "jump", "slot": "land", "play": "petramond:fp_jump", "fade_in": 0, "fade_out": 0.1},
    {"id": "hurt", "on": "hurt", "slot": "hurt", "play": "petramond:fp_hurt", "fade_in": 0, "fade_out": 0.08}
  ]
}
