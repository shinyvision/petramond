{
 "format": 1,
 "kind": "petramond:account",
 "class": "screen",
 "root": {
  "type": "frame",
  "layout": {
   "w": {
    "grow": 1
   },
   "h": {
    "grow": 1
   },
   "align": "center",
   "justify": "center"
  },
  "children": [
   {
    "type": "image",
    "image": "../../textures/gui/screenshot.png",
    "fit": "cover",
    "layout": {
     "w": {
      "grow": 1
     },
     "h": {
      "grow": 1
     },
     "abs": {
      "x": 0,
      "y": 0
     }
    }
   },
   {
    "type": "frame",
    "style": "panel.large",
    "layout": {
     "w": 320,
     "pad": [
      4,
      2,
      4,
      4
     ],
     "gap": 4,
     "align": "stretch"
    },
    "children": [
     {
      "type": "label",
      "text": "Account",
      "scale": 2
     },
     {
      "type": "frame",
      "style": "panel.inset",
      "layout": {
       "pad": [
        4,
        4,
        4,
        4
       ],
       "gap": 3,
       "align": "stretch"
      },
      "children": [
       {
        "type": "label",
        "style": "label.accent",
        "bind": {
         "text": "account_name"
        }
       },
       {
        "type": "label",
        "style": "label.muted",
        "bind": {
         "text": "account_detail"
        }
       }
      ]
     },
     {
      "type": "row",
      "layout": {
       "gap": 4,
       "align": "stretch"
      },
      "children": [
       {
        "type": "button",
        "id": "sign_in",
        "text": "Sign In",
        "layout": {
         "w": {
          "grow": 1
         }
        },
        "style": "button.success",
        "bind": {
         "visible": "signed_out"
        }
       },
       {
        "type": "button",
        "id": "sign_out",
        "text": "Log Out",
        "layout": {
         "w": {
          "grow": 1
         }
        },
        "bind": {
         "visible": "is_signed_in"
        }
       }
      ]
     },
     {
      "type": "label",
      "style": "label.muted",
      "bind": {
       "text": "working_text",
       "visible": "working"
      }
     },
     {
      "type": "scroll",
      "id": "status_scroll",
      "layout": {
       "h": {
        "grow": 1
       },
       "min_h": 12,
       "max_h": 26
      },
      "bind": {
       "visible": "has_status"
      },
      "children": [
       {
        "type": "label",
        "style": "label.danger",
        "wrap": true,
        "bind": {
         "text": "status_text"
        }
       }
      ]
     },
     {
      "type": "button",
      "id": "back",
      "text": "Back",
      "layout": {
       "w": {
        "grow": 1
       }
      }
     }
    ]
   }
  ]
 }
}
