{
  "format": 1,
  "kind": "petramond:hotbar",
  "class": "hud",
  "root": {
    "type": "row",
    "layout": {
      "w": "auto",
      "h": "auto",
      "pad": [
        0,
        0,
        0,
        0
      ],
      "margin": [
        0,
        0,
        0,
        1
      ],
      "gap": 0,
      "dir": "column",
      "justify": "start",
      "anchor": {
        "h": "center",
        "v": "end"
      }
    },
    "style": "list.row",
    "children": [
      {
        "type": "row",
        "layout": {
          "gap": 4,
          "align": "end"
        },
        "children": [
          {
            "type": "slot",
            "role": "off_hand"
          },
          {
            "type": "slot_grid",
            "role": "hotbar",
            "cols": 9,
            "rows": 1,
            "bind": {
              "selected": "active_slot"
            }
          }
        ]
      }
    ]
  }
}