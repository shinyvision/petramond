{
  "format": 1,
  "kind": "petramond:hotbar",
  "class": "hud",
  "root": {
    "type": "column",
    "layout": {
      "w": "auto",
      "h": "auto",
      "pad": [
        0,
        0,
        0,
        0
      ],
      "margin": [
        0,
        0,
        0,
        1
      ],
      "gap": 2,
      "dir": "column",
      "justify": "start",
      "anchor": {
        "h": "center",
        "v": "end"
      },
      "align": "center"
    },
    "children": [
      {
        "type": "label",
        "id": "creative_notice",
        "small": true,
        "bind": {
          "text": "creative_notice",
          "visible": "creative_notice_visible",
          "text_opacity": "creative_notice_opacity"
        },
        "wrap": true,
        "layout": {
          "max_w": 280
        }
      },
      {
        "type": "row",
        "layout": {
          "gap": 4,
          "align": "end"
        },
        "children": [
          {
            "type": "slot",
            "role": "off_hand"
          },
          {
            "type": "slot_grid",
            "role": "hotbar",
            "cols": 9,
            "rows": 1,
            "bind": {
              "selected": "active_slot"
            }
          }
        ],
        "style": "list.row"
      }
    ]
  }
}
