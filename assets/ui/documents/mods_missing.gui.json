{
    "format": 1,
    "kind": "petramond:mods_missing",
    "class": "screen",
    "root": {
        "type": "frame",
        "layout": {
            "w": {
                "grow": 1
            },
            "h": {
                "grow": 1
            },
            "align": "center",
            "justify": "center"
        },
        "children": [
            {
                "type": "image",
                "image": "../../textures/gui/screenshot.png",
                "fit": "cover",
                "layout": {
                    "w": {
                        "grow": 1
                    },
                    "h": {
                        "grow": 1
                    },
                    "abs": {
                        "x": 0,
                        "y": 0
                    }
                }
            },
            {
                "type": "frame",
                "style": "panel.large",
                "layout": {
                    "w": 280,
                    "h": 200,
                    "pad": [
                        4,
                        2,
                        4,
                        4
                    ],
                    "gap": 6,
                    "align": "stretch"
                },
                "children": [
                    {
                        "type": "label",
                        "text": "Missing Mods",
                        "scale": 2
                    },
                    {
                        "type": "label",
                        "wrap": true,
                        "bind": {
                            "text": "missing_intro"
                        }
                    },
                    {
                        "id": "missing_scroll",
                        "type": "scroll",
                        "axis": "vertical",
                        "style": "panel.inset",
                        "layout": {
                            "h": {
                                "grow": 1
                            },
                            "pad": [
                                1,
                                1,
                                1,
                                1
                            ],
                            "min_h": 36
                        },
                        "children": [
                            {
                                "id": "missing",
                                "type": "list",
                                "layout": {
                                    "gap": 2,
                                    "align": "stretch"
                                },
                                "bind": {
                                    "items": "missing_rows"
                                },
                                "children": [
                                    {
                                        "type": "row",
                                        "style": "list.row",
                                        "layout": {
                                            "pad": [
                                                3,
                                                1,
                                                3,
                                                1
                                            ],
                                            "gap": 5,
                                            "align": "center"
                                        },
                                        "children": [
                                            {
                                                "type": "label",
                                                "bind": {
                                                    "text": "id"
                                                }
                                            },
                                            {
                                                "type": "badge",
                                                "bind": {
                                                    "text": "version",
                                                    "visible": "has_version"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "label",
                        "text": "Install them, then try again.",
                        "style": "label.muted"
                    },
                    {
                        "type": "spacer",
                        "layout": {
                            "h": 2
                        }
                    },
                    {
                        "type": "row",
                        "layout": {
                            "gap": 5
                        },
                        "children": [
                            {
                                "type": "button",
                                "id": "open_anyway",
                                "text": "Open anyway",
                                "style": "button.danger",
                                "bind": {
                                    "visible": "can_open_anyway"
                                }
                            },
                            {
                                "type": "spacer",
                                "layout": {
                                    "w": {
                                        "grow": 1
                                    }
                                }
                            },
                            {
                                "type": "button",
                                "id": "back",
                                "text": "Back"
                            },
                            {
                                "type": "button",
                                "id": "get_missing",
                                "text": "Get missing",
                                "style": "button.success"
                            }
                        ]
                    }
                ]
            },
            {
                "type": "tooltip",
                "hover": "open_anyway",
                "id": "open_anyway_tooltip",
                "style": "panel.inset",
                "bind": {
                    "visible": "can_open_anyway"
                },
                "layout": {
                    "abs": {
                        "x": 4,
                        "y": 4
                    },
                    "pad": [
                        3,
                        2,
                        3,
                        3
                    ],
                    "align": "stretch",
                    "max_w": 200
                },
                "children": [
                    {
                        "type": "label",
                        "text": "Blocks and items from these packs become air when the world saves",
                        "small": true,
                        "wrap": true
                    }
                ]
            }
        ]
    }
}
