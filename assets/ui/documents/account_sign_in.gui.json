{
 "format": 1,
 "kind": "petramond:account_sign_in",
 "class": "screen",
 "root": {
  "type": "frame",
  "layout": {
   "w": {
    "grow": 1
   },
   "h": {
    "grow": 1
   },
   "align": "center",
   "justify": "center"
  },
  "children": [
   {
    "type": "image",
    "image": "../../textures/gui/screenshot.png",
    "fit": "cover",
    "layout": {
     "w": {
      "grow": 1
     },
     "h": {
      "grow": 1
     },
     "abs": {
      "x": 0,
      "y": 0
     }
    }
   },
   {
    "type": "frame",
    "style": "panel.large",
    "layout": {
     "w": 300,
     "pad": [
      4,
      2,
      4,
      4
     ],
     "gap": 4,
     "align": "stretch"
    },
    "children": [
     {
      "type": "label",
      "text": "Sign In",
      "scale": 2
     },
     {
      "type": "label",
      "style": "label.muted",
      "wrap": true,
      "bind": {
       "text": "service_line"
      }
     },
     {
      "type": "label",
      "text": "Username or Email",
      "style": "label.muted"
     },
     {
      "type": "text_input",
      "id": "account_id",
      "placeholder": "username",
      "max_chars": 254,
      "bind": {
       "text": "account_id"
      }
     },
     {
      "type": "label",
      "text": "Password",
      "style": "label.muted"
     },
     {
      "type": "text_input",
      "id": "account_password",
      "placeholder": "password",
      "max_chars": 128,
      "masked": true,
      "bind": {
       "text": "account_password"
      }
     },
     {
      "type": "label",
      "style": "label.muted",
      "bind": {
       "text": "working_text",
       "visible": "working"
      }
     },
     {
      "type": "scroll",
      "id": "status_scroll",
      "layout": {
       "h": {
        "grow": 1
       },
       "min_h": 12,
       "max_h": 34
      },
      "bind": {
       "visible": "has_status"
      },
      "children": [
       {
        "type": "label",
        "style": "label.danger",
        "wrap": true,
        "bind": {
         "text": "status_text"
        }
       }
      ]
     },
     {
      "type": "row",
      "layout": {
       "gap": 4,
       "align": "stretch"
      },
      "children": [
       {
        "type": "button",
        "id": "submit",
        "text": "Sign In",
        "layout": {
         "w": {
          "grow": 1
         }
        },
        "style": "button.success",
        "bind": {
         "enabled": "can_submit"
        }
       },
       {
        "type": "button",
        "id": "back",
        "text": "Back",
        "layout": {
         "w": {
          "grow": 1
         }
        }
       }
      ]
     }
    ]
   }
  ]
 }
}
