{
  "format": 1,
  "kind": "petramond:schematics",
  "class": "screen",
  "root": {
    "type": "column",
    "style": "panel.large",
    "layout": {
      "w": 304,
      "h": 230,
      "pad": [
        4,
        4,
        4,
        4
      ],
      "gap": 3,
      "align": "stretch",
      "anchor": {
        "h": "center",
        "v": "center"
      }
    },
    "children": [
      {
        "type": "frame",
        "layout": {
          "h": {
            "grow": 1
          },
          "min_h": 60,
          "align": "stretch"
        },
        "children": [
          {
            "type": "column",
            "layout": {
              "h": {
                "grow": 1
              },
              "gap": 3,
              "align": "stretch"
            },
            "bind": {
              "visible": "save_page"
            },
            "children": [
              {
                "type": "scroll",
                "id": "schematics_selection_scroll",
                "axis": "vertical",
                "layout": {
                  "h": {
                    "grow": 1
                  },
                  "min_h": 40,
                  "align": "stretch",
                  "gap": 3
                },
                "children": [
                  {
                    "type": "label",
                    "bind": {
                      "text": "selection_count"
                    }
                  },
                  {
                    "type": "text_input",
                    "id": "schematic_name",
                    "placeholder": "Schematic name…",
                    "max_chars": 64,
                    "bind": {
                      "text": "schematic_name"
                    }
                  },
                  {
                    "type": "row",
                    "layout": {
                      "gap": 4,
                      "align": "center"
                    },
                    "children": [
                      {
                        "type": "checkbox",
                        "id": "include_air",
                        "bind": {
                          "value": "include_air"
                        }
                      },
                      {
                        "type": "label",
                        "text": "Include air"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "row",
                "layout": {
                  "gap": 3,
                  "align": "center"
                },
                "children": [
                  {
                    "type": "button",
                    "id": "back_to_schematics",
                    "text": "Back"
                  },
                  {
                    "type": "spacer",
                    "layout": {
                      "w": {
                        "grow": 1
                      }
                    }
                  },
                  {
                    "type": "button",
                    "id": "clear_selection",
                    "text": "Clear",
                    "bind": {
                      "enabled": "can_clear"
                    }
                  },
                  {
                    "type": "button",
                    "id": "save_schematic",
                    "text": "Save",
                    "style": "button.success",
                    "bind": {
                      "enabled": "can_save"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "column",
            "layout": {
              "h": {
                "grow": 1
              },
              "gap": 3,
              "align": "stretch"
            },
            "children": [
              {
                "type": "scroll",
                "id": "schematics_library_scroll",
                "axis": "vertical",
                "layout": {
                  "h": {
                    "grow": 1
                  },
                  "min_h": 40,
                  "align": "stretch",
                  "gap": 3
                },
                "children": [
                  {
                    "type": "label",
                    "wrap": true,
                    "bind": {
                      "visible": "empty_library"
                    },
                    "text": "No saved schematics yet."
                  },
                  {
                    "type": "list",
                    "id": "schematic_list",
                    "layout": {
                      "gap": 3,
                      "align": "stretch"
                    },
                    "bind": {
                      "items": "schematics"
                    },
                    "children": [
                      {
                        "type": "frame",
                        "id": "schematic_card",
                        "layout": {
                          "dir": "row",
                          "h": 68,
                          "gap": 6,
                          "align": "start",
                          "pad": [
                            3,
                            3,
                            3,
                            3
                          ]
                        },
                        "children": [
                          {
                            "type": "image",
                            "image": "",
                            "layout": {
                              "w": 84,
                              "h": 56
                            },
                            "bind": {
                              "image": "thumbnail"
                            }
                          },
                          {
                            "type": "column",
                            "layout": {
                              "w": {
                                "grow": 1
                              },
                              "dir": "column",
                              "gap": 3,
                              "min_w": 0,
                              "h": {
                                "grow": 1
                              },
                              "justify": "center"
                            },
                            "children": [
                              {
                                "type": "label",
                                "wrap": false,
                                "bind": {
                                  "text": "name"
                                },
                                "layout": {
                                  "w": {
                                    "grow": 1
                                  },
                                  "min_w": 0,
                                  "margin": [
                                    0,
                                    0,
                                    56,
                                    0
                                  ]
                                }
                              },
                              {
                                "type": "label",
                                "small": true,
                                "wrap": false,
                                "bind": {
                                  "text": "details"
                                },
                                "layout": {
                                  "w": {
                                    "grow": 1
                                  },
                                  "min_w": 0
                                }
                              },
                              {
                                "type": "row",
                                "layout": {
                                  "gap": 2,
                                  "align": "start",
                                  "abs": {
                                    "x": 0,
                                    "y": 0
                                  },
                                  "w": {
                                    "grow": 1
                                  },
                                  "h": 24,
                                  "justify": "end"
                                },
                                "children": [
                                  {
                                    "type": "button",
                                    "id": "use_schematic",
                                    "icon": "icon.cube",
                                    "layout": {
                                      "w": 24,
                                      "h": 24
                                    }
                                  },
                                  {
                                    "type": "button",
                                    "id": "delete_schematic",
                                    "icon": "icon.trash",
                                    "style": "button.danger",
                                    "layout": {
                                      "w": 24,
                                      "h": 24
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ],
                        "style": "panel.inset"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "button",
                "id": "new_schematic",
                "icon": "icon.plus",
                "style": "button.success",
                "layout": {
                  "h": 22,
                  "align": "stretch"
                },
                "bind": {
                  "visible": "can_author"
                }
              }
            ],
            "bind": {
              "visible": "library_page"
            }
          },
          {
            "type": "column",
            "layout": {
              "gap": 8,
              "align": "center",
              "justify": "center",
              "h": {
                "grow": 1
              }
            },
            "bind": {
              "visible": "confirming_delete"
            },
            "children": [
              {
                "type": "label",
                "wrap": true,
                "bind": {
                  "text": "delete_question"
                },
                "layout": {
                  "max_w": 260
                }
              },
              {
                "type": "row",
                "layout": {
                  "gap": 4
                },
                "children": [
                  {
                    "type": "button",
                    "id": "cancel_delete",
                    "text": "Cancel"
                  },
                  {
                    "type": "button",
                    "id": "confirm_delete",
                    "text": "Delete",
                    "style": "button.danger"
                  }
                ]
              }
            ],
            "id": "schematic_delete_confirmation"
          }
        ]
      },
      {
        "type": "label",
        "id": "schematics_notice",
        "small": true,
        "wrap": true,
        "bind": {
          "text": "notice",
          "visible": "notice"
        }
      },
      {
        "type": "tooltip",
        "hover": "use_schematic",
        "children": [
          {
            "type": "label",
            "text": "Use schematic",
            "small": true,
            "wrap": true
          }
        ],
        "bind": {
          "visible": "browsing"
        },
        "id": "use_schematic_tooltip",
        "style": "panel.inset",
        "layout": {
          "abs": {
            "x": 4,
            "y": 4
          },
          "pad": [
            3,
            2,
            3,
            3
          ],
          "align": "stretch"
        }
      },
      {
        "type": "tooltip",
        "hover": "delete_schematic",
        "children": [
          {
            "type": "label",
            "text": "Delete schematic",
            "small": true,
            "wrap": true
          }
        ],
        "bind": {
          "visible": "browsing"
        },
        "id": "delete_schematic_tooltip",
        "style": "panel.inset",
        "layout": {
          "abs": {
            "x": 4,
            "y": 4
          },
          "pad": [
            3,
            2,
            3,
            3
          ],
          "align": "stretch"
        }
      }
    ]
  }
}