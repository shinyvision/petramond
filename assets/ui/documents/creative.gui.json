{
  "format": 1,
  "kind": "petramond:creative",
  "class": "container",
  "root": {
    "type": "column",
    "style": "panel.large",
    "layout": {
      "w": 304,
      "h": 230,
      "pad": [
        4,
        4,
        4,
        4
      ],
      "gap": 3,
      "align": "stretch",
      "anchor": {
        "h": "center",
        "v": "center"
      }
    },
    "children": [
      {
        "type": "tab_bar",
        "id": "creative_tabs",
        "tabs": [
          {
            "key": "items",
            "icon": "icon.grass_block"
          },
          {
            "key": "schematics",
            "icon": "icon.clipboard"
          }
        ],
        "bind": {
          "selected": "tab",
          "enabled": "browsing"
        },
        "style": "tab.creative",
        "layout": {
          "h": 24
        }
      },
      {
        "type": "frame",
        "layout": {
          "h": {
            "grow": 1
          },
          "min_h": 60,
          "align": "stretch"
        },
        "children": [
          {
            "type": "column",
            "layout": {
              "h": {
                "grow": 1
              },
              "gap": 3,
              "align": "stretch"
            },
            "children": [
              {
                "type": "text_input",
                "id": "creative_search",
                "placeholder": "Search items or mod names\u2026",
                "max_chars": 64,
                "bind": {
                  "text": "search"
                }
              },
              {
                "type": "frame",
                "layout": {
                  "h": {
                    "grow": 1
                  },
                  "min_h": 40,
                  "align": "stretch"
                },
                "children": [
                  {
                    "type": "scroll",
                    "id": "creative_catalog_scroll",
                    "axis": "vertical",
                    "layout": {
                      "h": {
                        "grow": 1
                      },
                      "min_h": 40,
                      "align": "stretch",
                      "gap": 3
                    },
                    "children": [
                      {
                        "type": "list",
                        "id": "creative_items",
                        "cols": 12,
                        "layout": {
                          "gap": 1,
                          "align": "stretch"
                        },
                        "bind": {
                          "items": "items"
                        },
                        "children": [
                          {
                            "type": "button",
                            "id": "creative_item",
                            "style": "slot.recipe",
                            "layout": {
                              "h": 20,
                              "align": "center",
                              "justify": "center"
                            },
                            "children": [
                              {
                                "type": "hook",
                                "id": "creative_item_icon",
                                "layout": {
                                  "w": 16,
                                  "h": 16
                                },
                                "bind": {
                                  "item": "item_icon"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "id": "discard_creative_cursor",
                    "style": "button.invisible",
                    "layout": {
                      "abs": {
                        "x": 0,
                        "y": 0
                      },
                      "w": {
                        "grow": 1
                      },
                      "h": {
                        "grow": 1
                      }
                    },
                    "bind": {
                      "visible": "cursor_has_stack"
                    }
                  }
                ]
              }
            ],
            "bind": {
              "visible": "catalog_tab"
            }
          },
          {
            "type": "column",
            "layout": {
              "h": {
                "grow": 1
              },
              "gap": 3,
              "align": "stretch"
            },
            "bind": {
              "visible": "selection_tab"
            },
            "children": [
              {
                "type": "scroll",
                "id": "creative_selection_scroll",
                "axis": "vertical",
                "layout": {
                  "h": {
                    "grow": 1
                  },
                  "min_h": 40,
                  "align": "stretch",
                  "gap": 3
                },
                "children": [
                  {
                    "type": "label",
                    "bind": {
                      "text": "selection_count"
                    }
                  },
                  {
                    "type": "text_input",
                    "id": "schematic_name",
                    "placeholder": "Schematic name\u2026",
                    "max_chars": 64,
                    "bind": {
                      "text": "schematic_name"
                    }
                  },
                  {
                    "type": "row",
                    "layout": {
                      "gap": 4,
                      "align": "center"
                    },
                    "children": [
                      {
                        "type": "checkbox",
                        "id": "include_air",
                        "bind": {
                          "value": "include_air"
                        }
                      },
                      {
                        "type": "label",
                        "text": "Include air"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "row",
                "layout": {
                  "gap": 3,
                  "align": "center"
                },
                "children": [
                  {
                    "type": "button",
                    "id": "back_to_schematics",
                    "text": "Back"
                  },
                  {
                    "type": "spacer",
                    "layout": {
                      "w": {
                        "grow": 1
                      }
                    }
                  },
                  {
                    "type": "button",
                    "id": "clear_selection",
                    "text": "Clear",
                    "bind": {
                      "enabled": "can_clear"
                    }
                  },
                  {
                    "type": "button",
                    "id": "save_schematic",
                    "text": "Save",
                    "style": "button.success",
                    "bind": {
                      "enabled": "can_save"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "column",
            "layout": {
              "h": {
                "grow": 1
              },
              "gap": 3,
              "align": "stretch"
            },
            "children": [
              {
                "type": "scroll",
                "id": "creative_library_scroll",
                "axis": "vertical",
                "layout": {
                  "h": {
                    "grow": 1
                  },
                  "min_h": 40,
                  "align": "stretch",
                  "gap": 3
                },
                "children": [
                  {
                    "type": "label",
                    "wrap": true,
                    "bind": {
                      "visible": "empty_library"
                    },
                    "text": "No saved schematics yet."
                  },
                  {
                    "type": "list",
                    "id": "schematic_list",
                    "layout": {
                      "gap": 3,
                      "align": "stretch"
                    },
                    "bind": {
                      "items": "schematics"
                    },
                    "children": [
                      {
                        "type": "frame",
                        "id": "schematic_card",
                        "layout": {
                          "dir": "row",
                          "h": 68,
                          "gap": 6,
                          "align": "start",
                          "pad": [
                            3,
                            3,
                            3,
                            3
                          ]
                        },
                        "children": [
                          {
                            "type": "image",
                            "image": "",
                            "layout": {
                              "w": 84,
                              "h": 56
                            },
                            "bind": {
                              "image": "thumbnail"
                            }
                          },
                          {
                            "type": "column",
                            "layout": {
                              "w": {
                                "grow": 1
                              },
                              "dir": "column",
                              "gap": 3,
                              "min_w": 0,
                              "h": {
                                "grow": 1
                              },
                              "justify": "center"
                            },
                            "children": [
                              {
                                "type": "label",
                                "wrap": false,
                                "bind": {
                                  "text": "name"
                                },
                                "layout": {
                                  "w": {
                                    "grow": 1
                                  },
                                  "min_w": 0,
                                  "margin": [
                                    0,
                                    0,
                                    56,
                                    0
                                  ]
                                }
                              },
                              {
                                "type": "label",
                                "small": true,
                                "wrap": false,
                                "bind": {
                                  "text": "details"
                                },
                                "layout": {
                                  "w": {
                                    "grow": 1
                                  },
                                  "min_w": 0
                                }
                              },
                              {
                                "type": "row",
                                "layout": {
                                  "gap": 2,
                                  "align": "start",
                                  "abs": {
                                    "x": 0,
                                    "y": 0
                                  },
                                  "w": {
                                    "grow": 1
                                  },
                                  "h": 24,
                                  "justify": "end"
                                },
                                "children": [
                                  {
                                    "type": "button",
                                    "id": "place_schematic",
                                    "icon": "icon.cube",
                                    "layout": {
                                      "w": 24,
                                      "h": 24
                                    }
                                  },
                                  {
                                    "type": "button",
                                    "id": "delete_schematic",
                                    "icon": "icon.trash",
                                    "style": "button.danger",
                                    "layout": {
                                      "w": 24,
                                      "h": 24
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ],
                        "style": "panel.inset"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "button",
                "id": "new_schematic",
                "icon": "icon.plus",
                "style": "button.success",
                "layout": {
                  "h": 22,
                  "align": "stretch"
                }
              }
            ],
            "bind": {
              "visible": "library_tab"
            }
          },
          {
            "type": "column",
            "layout": {
              "gap": 8,
              "align": "center",
              "justify": "center",
              "h": {
                "grow": 1
              }
            },
            "bind": {
              "visible": "confirming_delete"
            },
            "children": [
              {
                "type": "label",
                "wrap": true,
                "bind": {
                  "text": "delete_question"
                },
                "layout": {
                  "max_w": 260
                }
              },
              {
                "type": "row",
                "layout": {
                  "gap": 4
                },
                "children": [
                  {
                    "type": "button",
                    "id": "cancel_delete",
                    "text": "Cancel"
                  },
                  {
                    "type": "button",
                    "id": "confirm_delete",
                    "text": "Delete",
                    "style": "button.danger"
                  }
                ]
              }
            ],
            "id": "schematic_delete_confirmation"
          }
        ]
      },
      {
        "type": "row",
        "bind": {
          "visible": "browsing"
        },
        "layout": {
          "justify": "center"
        },
        "children": [
          {
            "type": "slot_grid",
            "role": "hotbar",
            "cols": 9,
            "rows": 1,
            "bind": {
              "selected": "active_slot"
            }
          },
          {
            "type": "column",
            "overlay": true,
            "bind": {
              "visible": "creative_notice_visible"
            },
            "layout": {
              "abs": {
                "x": 0,
                "y": -76
              },
              "w": {
                "grow": 1
              },
              "h": 48,
              "justify": "end",
              "align": "center"
            },
            "children": [
              {
                "type": "label",
                "id": "creative_notice",
                "small": true,
                "bind": {
                  "text": "creative_notice",
                  "visible": "creative_notice_visible",
                  "text_opacity": "creative_notice_opacity"
                },
                "wrap": true,
                "layout": {
                  "max_w": 280
                }
              }
            ]
          }
        ],
        "id": "creative_hotbar"
      },
      {
        "type": "tooltip",
        "hover": "place_schematic",
        "children": [
          {
            "type": "label",
            "text": "Place schematic",
            "small": true,
            "wrap": true
          }
        ],
        "bind": {
          "visible": "browsing"
        },
        "id": "place_schematic_tooltip",
        "style": "panel.inset",
        "layout": {
          "abs": {
            "x": 4,
            "y": 4
          },
          "pad": [
            3,
            2,
            3,
            3
          ],
          "align": "stretch"
        }
      },
      {
        "type": "tooltip",
        "hover": "delete_schematic",
        "children": [
          {
            "type": "label",
            "text": "Delete schematic",
            "small": true,
            "wrap": true
          }
        ],
        "bind": {
          "visible": "browsing"
        },
        "id": "delete_schematic_tooltip",
        "style": "panel.inset",
        "layout": {
          "abs": {
            "x": 4,
            "y": 4
          },
          "pad": [
            3,
            2,
            3,
            3
          ],
          "align": "stretch"
        }
      }
    ]
  }
}
