{
  "version": 2,
  "document": {
    "format": 1,
    "kind": "petramond:hotbar",
    "class": "hud",
    "root": {
      "type": "column",
      "layout": {
        "w": "auto",
        "h": "auto",
        "pad": [
          0,
          0,
          0,
          0
        ],
        "margin": [
          0,
          0,
          0,
          1
        ],
        "gap": 2,
        "dir": "column",
        "align": "center",
        "justify": "start",
        "anchor": {
          "h": "center",
          "v": "end"
        }
      },
      "children": [
        {
          "id": "creative_notice",
          "type": "label",
          "wrap": true,
          "small": true,
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              0,
              0,
              0,
              0
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 0,
            "dir": "column",
            "justify": "start",
            "max_w": 280
          },
          "bind": {
            "text": "creative_notice",
            "visible": "creative_notice_visible",
            "text_opacity": "creative_notice_opacity"
          }
        },
        {
          "type": "row",
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              0,
              0,
              0,
              0
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 4,
            "dir": "column",
            "align": "end",
            "justify": "start"
          },
          "style": "list.row",
          "children": [
            {
              "type": "slot",
              "role": "off_hand"
            },
            {
              "type": "slot_grid",
              "role": "hotbar",
              "cols": 9,
              "rows": 1,
              "bind": {
                "selected": "active_slot"
              }
            }
          ]
        }
      ]
    }
  },
  "editor": {
    "sample_state": {
      "active_slot": {
        "i32": 0
      },
      "creative_notice": {
        "str": "Sample text"
      },
      "creative_notice_opacity": {
        "f32": 0.5
      },
      "creative_notice_visible": {
        "bool": true
      }
    },
    "zoom": 1.0,
    "preview_scale": 2,
    "screen": [
      1280,
      720
    ],
    "pixel_grid": false
  }
}