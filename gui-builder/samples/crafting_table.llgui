{
  "version": 2,
  "document": {
    "format": 1,
    "kind": "petramond:crafting_table",
    "class": "container",
    "root": {
      "type": "column",
      "layout": {
        "w": 220,
        "h": "auto",
        "pad": [
          4,
          3,
          4,
          4
        ],
        "margin": [
          0,
          0,
          0,
          0
        ],
        "gap": 3,
        "dir": "column",
        "align": "stretch",
        "justify": "start",
        "anchor": {
          "h": "center",
          "v": "center"
        }
      },
      "style": "panel.large",
      "children": [
        {
          "type": "label",
          "text": "Crafting Table",
          "bind": {
            "text": "craft_station_title"
          }
        },
        {
          "type": "row",
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              0,
              0,
              0,
              0
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 2,
            "dir": "column",
            "align": "stretch",
            "justify": "start"
          },
          "children": [
            {
              "id": "craft_search",
              "type": "text_input",
              "placeholder": "Search recipes...",
              "max_chars": 64,
              "layout": {
                "w": {
                  "grow": 1
                },
                "h": "auto",
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 0,
                "dir": "column",
                "justify": "start"
              },
              "bind": {
                "text": "craft_search"
              }
            },
            {
              "id": "craft_filter",
              "type": "toggle",
              "icon": "icon.craft_filter",
              "layout": {
                "w": 18,
                "h": 18,
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 0,
                "dir": "column",
                "justify": "start"
              },
              "style": "button.toggle",
              "bind": {
                "value": "craft_filter_on"
              }
            }
          ]
        },
        {
          "type": "label",
          "text": "No matching recipes",
          "style": "label.muted",
          "bind": {
            "text": "craft_empty_hint",
            "visible": "no_craft_results"
          }
        },
        {
          "id": "craft_scroll",
          "type": "scroll",
          "axis": "vertical",
          "layout": {
            "w": "auto",
            "h": {
              "grow": 1
            },
            "pad": [
              1,
              1,
              1,
              1
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 0,
            "dir": "column",
            "justify": "start",
            "min_h": 40
          },
          "style": "panel.inset",
          "children": [
            {
              "id": "craft_recipes_list",
              "type": "list",
              "cols": 9,
              "layout": {
                "w": "auto",
                "h": "auto",
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 1,
                "dir": "column",
                "align": "stretch",
                "justify": "start"
              },
              "bind": {
                "items": "craft_recipes",
                "selected": "craft_recipe_sel"
              },
              "children": [
                {
                  "id": "recipe",
                  "type": "button",
                  "layout": {
                    "w": "auto",
                    "h": 18,
                    "pad": [
                      0,
                      0,
                      0,
                      0
                    ],
                    "margin": [
                      0,
                      0,
                      0,
                      0
                    ],
                    "gap": 0,
                    "dir": "row",
                    "align": "center",
                    "justify": "center"
                  },
                  "style": "slot.recipe",
                  "bind": {
                    "enabled": "enabled"
                  },
                  "children": [
                    {
                      "id": "recipe_result",
                      "type": "hook",
                      "layout": {
                        "w": 16,
                        "h": 16,
                        "pad": [
                          0,
                          0,
                          0,
                          0
                        ],
                        "margin": [
                          0,
                          0,
                          0,
                          0
                        ],
                        "gap": 0,
                        "dir": "column",
                        "justify": "start"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              0,
              0,
              0,
              0
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 3,
            "dir": "column",
            "align": "center",
            "justify": "start"
          },
          "children": [
            {
              "type": "slot",
              "role": "craft_result"
            },
            {
              "id": "craft",
              "type": "button",
              "text": "CRAFT",
              "layout": {
                "w": {
                  "grow": 1
                },
                "h": "auto",
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 0,
                "dir": "column",
                "justify": "start"
              },
              "style": "button.success",
              "bind": {
                "enabled": "can_craft"
              }
            }
          ]
        },
        {
          "type": "label",
          "text": "Inventory"
        },
        {
          "type": "column",
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              0,
              0,
              0,
              0
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 0,
            "dir": "column",
            "align": "center",
            "justify": "start"
          },
          "children": [
            {
              "type": "slot_grid",
              "role": "player_inv",
              "cols": 9,
              "rows": 3
            },
            {
              "type": "slot_grid",
              "role": "hotbar",
              "cols": 9,
              "rows": 1,
              "layout": {
                "w": "auto",
                "h": "auto",
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  2,
                  0,
                  0
                ],
                "gap": 0,
                "dir": "column",
                "justify": "start"
              }
            }
          ]
        },
        {
          "type": "tooltip",
          "layout": {
            "w": "auto",
            "h": "auto",
            "pad": [
              3,
              2,
              3,
              3
            ],
            "margin": [
              0,
              0,
              0,
              0
            ],
            "gap": 2,
            "dir": "column",
            "align": "stretch",
            "justify": "start",
            "max_w": 150,
            "abs": {
              "x": 4,
              "y": 4
            }
          },
          "style": "panel.inset",
          "bind": {
            "visible": "show_recipe_tip"
          },
          "children": [
            {
              "type": "row",
              "layout": {
                "w": "auto",
                "h": "auto",
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 3,
                "dir": "column",
                "align": "center",
                "justify": "start"
              },
              "children": [
                {
                  "id": "craft_tip_result",
                  "type": "hook",
                  "layout": {
                    "w": 16,
                    "h": 16,
                    "pad": [
                      0,
                      0,
                      0,
                      0
                    ],
                    "margin": [
                      0,
                      0,
                      0,
                      0
                    ],
                    "gap": 0,
                    "dir": "column",
                    "justify": "start"
                  }
                },
                {
                  "type": "label",
                  "small": true,
                  "bind": {
                    "text": "craft_tip_name"
                  }
                }
              ]
            },
            {
              "id": "craft_tip_ingredients",
              "type": "hook",
              "layout": {
                "w": {
                  "grow": 1
                },
                "h": 12,
                "pad": [
                  0,
                  0,
                  0,
                  0
                ],
                "margin": [
                  0,
                  0,
                  0,
                  0
                ],
                "gap": 0,
                "dir": "column",
                "justify": "start",
                "min_w": 84
              }
            }
          ]
        }
      ]
    }
  },
  "editor": {
    "sample_state": {
      "can_craft": {
        "bool": true
      },
      "craft_filter_on": {
        "bool": true
      },
      "craft_recipe_sel": {
        "i32": 0
      },
      "craft_recipes": {
        "list": [
          {
            "enabled": {
              "bool": true
            },
            "name": {
              "str": "First item"
            }
          },
          {
            "enabled": {
              "bool": true
            },
            "name": {
              "str": "Second item"
            }
          },
          {
            "enabled": {
              "bool": true
            },
            "name": {
              "str": "Third item"
            }
          }
        ]
      },
      "craft_search": {
        "str": "Sample text"
      },
      "craft_tip_name": {
        "str": "Sample text"
      },
      "item_tip_has_info": {
        "bool": true
      },
      "item_tip_info": {
        "str": "Sample text"
      },
      "item_tip_name": {
        "str": "Sample text"
      },
      "no_craft_results": {
        "bool": true
      },
      "show_item_tip": {
        "bool": true
      },
      "show_recipe_tip": {
        "bool": true
      }
    },
    "zoom": 1.0,
    "preview_scale": 2,
    "screen": [
      1280,
      720
    ],
    "pixel_grid": false
  }
}